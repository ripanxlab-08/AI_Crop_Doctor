# =====================================================================
# AI Crop Doctor - Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real secrets to git.
# =====================================================================

# ------ Supabase -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ------ OpenAI ---------------------------------------------------------
NEXT_PUBLIC_OPENAI_API_KEY=sk-proj-your_openai_key_here

# ------ API Base URL ---------------------------------------------------
# LOCAL:  /api  (relative — works on localhost:3000)
# VERCEL: /api  (relative — Vercel resolves to the deployed domain automatically)
NEXT_PUBLIC_API_BASE_URL=/api
